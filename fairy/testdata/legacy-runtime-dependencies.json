{
  "roots": [
    ".",
    "../desktop"
  ],
  "rules": {
    "postgres_driver": {
      "pattern": "github.com/jackc/pgx|gorm.io/driver/postgres",
      "maxFiles": 0
    },
    "pgvector": {
      "pattern": "github.com/pgvector|pgvector/pgvector|CREATE EXTENSION.*vector",
      "maxFiles": 0
    },
    "qdrant": {
      "pattern": "qdrant",
      "maxFiles": 0
    },
    "compose_data_services": {
      "pattern": "postgres:|pgvector/pgvector|fairy-postgres|openserp:",
      "maxFiles": 0
    },
    "remote_core_connection": {
      "pattern": "defaultCoreEndpoint|CoreEndpoint|FAIRY_CORE_ENDPOINT|FAIRY_CORE_TOKEN",
      "maxFiles": 0
    }
  }
}
