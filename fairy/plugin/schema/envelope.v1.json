{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairy.local/plugin/abi/v1/envelope.json",
  "title": "FAIRY plugin ABI v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["abiVersion", "kind", "correlation"],
  "properties": {
    "abiVersion": { "type": "integer", "const": 1 },
    "kind": {
      "type": "string",
      "enum": ["init", "handle", "shutdown", "result", "error"]
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginInstanceId"],
      "properties": {
        "pluginInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceId": { "type": "string", "maxLength": 128 },
        "turnId": { "type": "string", "maxLength": 128 },
        "externalMessageId": { "type": "string", "maxLength": 128 }
      }
    },
    "payload": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ABI_INCOMPATIBLE",
            "MANIFEST_INVALID",
            "CAPABILITY_DENIED",
            "BUDGET_EXCEEDED",
            "MODULE_TRAP",
            "CANCELLED"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
