# FAIRY Core 与 PostgreSQL。所有 secret 都必须替换，空值会使 Compose 明确失败。
FAIRY_POSTGRES_PASSWORD=
FAIRY_SECRET_MASTER_KEY=
FAIRY_API_TOKEN=
FAIRY_RUNTIME_PROFILE=full

# PMHQ/LuckyLillia 授权，由 LLOneBot 官方部署使用；它不是 OneBot access token。
LLONEBOT_AUTH_TOKEN=

# 可选：已经登录过时指定 QQ 号以快速登录。首次使用可留空并在 WebUI 扫码。
LLONEBOT_QUICK_LOGIN_QQ=

# FAIRY 与 LLOneBot 共同使用的 OneBot access token，不得复用上面的 PMHQ 授权。
FAIRY_ONEBOT_TOKEN=
