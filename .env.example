# FAIRY Core 与 PostgreSQL。所有 secret 都必须替换，空值会使 Compose 明确失败。
FAIRY_POSTGRES_PASSWORD=
FAIRY_SECRET_MASTER_KEY=
FAIRY_API_TOKEN=
FAIRY_RUNTIME_PROFILE=full

# LLBot direct 授权，从 https://auth.luckylillia.com 获取；不能随机生成，也不是 OneBot access token。
LLBOT_AUTH_TOKEN=

# LLBot WebUI 登录密码。独立设置，只使用英文字母和数字，不得复用 LLBot auth 或 OneBot token。
LLBOT_WEBUI_TOKEN=

# FAIRY 与 LLBot 共同使用的 OneBot access token，不得复用上面的 LLBot auth 或 WebUI 密码。
FAIRY_ONEBOT_TOKEN=
