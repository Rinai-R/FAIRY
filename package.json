{
  "name": "fairy",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test:go": "go test -C fairy ./...",
    "test:openspec": "node --test scripts/openspec-domain.test.mjs",
    "openspec:domain": "node scripts/openspec-domain.mjs",
    "build": "mkdir -p bin && go build -C fairy -o ../bin/fairy .",
    "web:dev": "pnpm --filter @fairy/web dev",
    "web:build": "pnpm --filter @fairy/web build"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0"
  }
}
